# Public site URL used for SEO, sitemap, and Creem success redirects.
# Production example: https://your-domain.com
APP_URL=http://localhost:3000

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
# Public by design for gtag. Do not put API keys here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# DeepSeek — server only. Never prefix with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=

# Creem — server only. Never prefix with NEXT_PUBLIC_.
# Test: https://test-api.creem.io
# Production: https://api.creem.io
CREEM_API_KEY=
CREEM_API_URL=https://test-api.creem.io
CREEM_PRODUCT_ID_CREATOR=
CREEM_PRODUCT_ID_PRO=
